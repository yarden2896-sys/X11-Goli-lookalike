              <label class="pp-option-label">
                {{ option.name }}:
                <strong class="pp-option-selected" data-pp-opt="{{ option.position }}">{{ option.selected_value }}</strong>
              </label>
              <div class="pp-option-btns" role="group" aria-label="{{ option.name }}">
                {%- for value in option.values -%}
                  <button class="pp-opt-btn {% if option.selected_value == value %}active{% endif %}"
                          data-option="{{ option.position }}"
                          data-value="{{ value | escape }}">
                    {{ value }}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endunless -%}

      {%- form 'product', product, id: 'product-form' -%}
        <input type="hidden" name="id" id="variant-id" value="{{ selected_variant.id }}" />

