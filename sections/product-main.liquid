<!-- ═══════════ PRODUCT PAGE — HIGH CONVERSION LANDING PAGE ═══════════ -->
{%- assign selected_variant = product.selected_or_first_available_variant -%}
{%- assign pp_h = product.handle -%}

<!-- URGENCY TOP TICKER -->
<div class="pp-urgency-top" id="pp-urgency-top">
  <div class="pp-ut-inner">
    <span class="pp-ut-fire">🔥</span>
    <span class="pp-ut-text"><strong>FLASH SALE — 30% OFF</strong> &nbsp;Sale ends in:</span>
    <div class="pp-ut-countdown">
      <span class="pp-ut-cd" id="pp-ut-h" data-pp-cd-h>00</span>
      <span class="pp-ut-sep">:</span>
      <span class="pp-ut-cd" id="pp-ut-m" data-pp-cd-m>14</span>
      <span class="pp-ut-sep">:</span>
      <span class="pp-ut-cd" id="pp-ut-s" data-pp-cd-s>47</span>
    </div>
    <span class="pp-ut-code">Use code <strong>GAINX11</strong></span>
  </div>
</div>

<div class="pp-main" id="top">

  <!-- ═══ HERO BUY ZONE ═══ -->
  <div class="container pp-hero-grid">

    <!-- Gallery -->
    <div class="pp-gallery" id="pp-gallery">
      <div class="pp-main-img-wrap">
        {%- if product.featured_image -%}
          <img src="{{ product.featured_image | img_url: '800x1000', crop: 'center' }}"
               alt="{{ product.featured_image.alt | default: product.title | escape }}"
               id="pp-main-img"
               loading="eager"
               width="800" height="1000"
               class="pp-main-img" />
        {%- endif -%}
      </div>

      {%- if product.images.size > 1 -%}
      <div class="pp-thumbs">
        {%- for image in product.images limit: 6 -%}
          <button class="pp-thumb {% if forloop.first %}active{% endif %}"
                  data-pp-src="{{ image | img_url: '800x1000', crop: 'center' }}"
                  data-pp-alt="{{ image.alt | default: product.title | escape }}"
                  aria-label="View image {{ forloop.index }}">
            <img src="{{ image | img_url: '120x150', crop: 'center' }}" alt="" loading="lazy" />
          </button>
        {%- endfor -%}
      </div>
      {%- endif -%}

      <div class="pp-media-logos">
        <span class="pp-ml-label">Trusted by</span>
        <div class="pp-ml-list">
          <span>10,000+ Happy Customers</span><span>·</span>
          <span>4.9 ★ Average Rating</span><span>·</span>
          <span>🔒 Secure Checkout</span>
        </div>
      </div>
    </div>

    <!-- Buy Box -->
    <div class="pp-buy-box">
      <div class="pp-breadcrumb">
        <a href="/collections/all">All Products</a> <span>/</span> {{ product.title }}
      </div>

      <div class="pp-social-proof-bar">
        <span class="pp-stars-inline">★★★★★</span>
        <a href="#pp-reviews" class="pp-review-link">2,400+ Verified Reviews</a>
        <span class="pp-sp-dot">·</span>
        <span class="pp-purchases">🛒 <strong>847</strong> purchased this week</span>
      </div>

      {%- if section.settings.hero_badge != blank -%}
        <div class="pp-hero-badge-pill">{{ section.settings.hero_badge }}</div>
      {%- endif -%}
      <h1 class="pp-title">{{ product.title }}</h1>
      <p class="pp-subtitle">
        {%- if section.settings.hero_subtitle != blank -%}
          {{ section.settings.hero_subtitle }}
        {%- elsif product.description != blank -%}
          {{ product.description | strip_html | truncate: 160 }}
        {%- endif -%}
      </p>

      <div class="pp-pricing-row" id="pp-pricing">
        <span class="pp-price" id="pp-price">{{ selected_variant.price | money }}</span>
        {%- if selected_variant.compare_at_price > selected_variant.price -%}
          <span class="pp-compare" id="pp-compare">{{ selected_variant.compare_at_price | money }}</span>
          <span class="pp-save-chip" id="pp-save-chip">
            SAVE {{ selected_variant.compare_at_price | minus: selected_variant.price | times: 100 | divided_by: selected_variant.compare_at_price | round }}%
          </span>
        {%- endif -%}
      </div>
      <div class="pp-per-serving" id="pp-per-serving">Only <strong>{{ selected_variant.price | divided_by: 30 | money }}</strong>/serving — less than a cup of coffee ☕</div>

      <div class="pp-stock-line">
        <span class="pp-stock-pulse"></span>
        <span>In Stock — <strong>Only 23 left</strong> at this price. Ships today!</span>
      </div>

      <div class="pp-deal-bar">
        <span class="pp-deal-label">⚡ Sale ends in:</span>
        <div class="pp-deal-cd">
          <div class="pp-dcd-unit"><span data-pp-cd-h>00</span><small>HRS</small></div>
          <span class="pp-dcd-sep">:</span>
          <div class="pp-dcd-unit"><span data-pp-cd-m>14</span><small>MIN</small></div>
          <span class="pp-dcd-sep">:</span>
          <div class="pp-dcd-unit"><span data-pp-cd-s>47</span><small>SEC</small></div>
        </div>
      </div>

