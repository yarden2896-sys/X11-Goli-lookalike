    <!-- Gallery -->
    <div class="pp-gallery" id="pp-gallery">
      <div class="pp-main-img-wrap">
        {%- if product.featured_image -%}
          <img src="{{ product.featured_image | img_url: '800x1000', crop: 'center' }}"
               alt="{{ product.featured_image.alt | default: product.title | escape }}"
               id="pp-main-img"
               loading="eager"
               width="800" height="1000"
               class="pp-main-img" />
        {%- endif -%}
        <div class="pp-img-badge">#1 Women's Creatine Gummy</div>
      </div>

      {%- if product.images.size > 1 -%}
      <div class="pp-thumbs">
        {%- for image in product.images limit: 6 -%}
          <button class="pp-thumb {% if forloop.first %}active{% endif %}"
                  data-pp-src="{{ image | img_url: '800x1000', crop: 'center' }}"
                  data-pp-alt="{{ image.alt | default: product.title | escape }}"
                  aria-label="View image {{ forloop.index }}">
            <img src="{{ image | img_url: '120x150', crop: 'center' }}" alt="" loading="lazy" />
          </button>
        {%- endfor -%}
      </div>
      {%- endif -%}

      <div class="pp-media-logos">
        <span class="pp-ml-label">As featured in</span>
        <div class="pp-ml-list">
          <span>Women's Health</span><span>·</span>
          <span>Shape</span><span>·</span>
          <span>Forbes</span><span>·</span>
          <span>Muscle & Fitness</span>
        </div>
      </div>
    </div>

    <!-- Buy Box -->
    <div class="pp-buy-box">
      <div class="pp-breadcrumb">
        <a href="/collections/all">All Products</a> <span>/</span> {{ product.title }}
