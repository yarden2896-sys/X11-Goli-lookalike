<!-- ═══════════ PRODUCT PAGE — HIGH CONVERSION LANDING PAGE ═══════════ -->
{%- assign selected_variant = product.selected_or_first_available_variant -%}

<!-- URGENCY TOP TICKER -->
<div class="pp-urgency-top" id="pp-urgency-top">
  <div class="pp-ut-inner">
    <span class="pp-ut-fire">🔥</span>
    <span class="pp-ut-text"><strong>FLASH SALE — 30% OFF</strong> &nbsp;Sale ends in:</span>
    <div class="pp-ut-countdown">
      <span class="pp-ut-cd" id="pp-ut-h" data-pp-cd-h>00</span>
      <span class="pp-ut-sep">:</span>
      <span class="pp-ut-cd" id="pp-ut-m" data-pp-cd-m>14</span>
      <span class="pp-ut-sep">:</span>
      <span class="pp-ut-cd" id="pp-ut-s" data-pp-cd-s>47</span>
    </div>
    <span class="pp-ut-code">Use code <strong>GAINX11</strong></span>
  </div>
</div>

<div class="pp-main" id="top">

  <!-- ═══ HERO BUY ZONE ═══ -->
