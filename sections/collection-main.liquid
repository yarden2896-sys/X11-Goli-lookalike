<!-- ═══════════ COLLECTION PAGE ═══════════ -->
<div class="collection-main">
  <div class="coll-hero">
    <div class="container">
      <h1 class="coll-title">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <p class="coll-desc">{{ collection.description }}</p>
      {%- else -%}
        <p class="coll-desc">Premium gummy supplements for peak performance. Clean ingredients. Clinical doses. Flavours you'll love.</p>
      {%- endif -%}
      <div class="coll-meta">{{ collection.products_count }} product{{ collection.products_count | plural: '', 's' }}</div>
    </div>
  </div>

  <div class="container">
    {%- if collection.products.size > 0 -%}
      <div class="product-grid">
        {%- for product in collection.products -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div class="pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="btn btn-outline">&larr; Previous</a>
          {%- endif -%}
          <span class="page-info">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="btn btn-outline">Next &rarr;</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="coll-empty">
        <p>No products found in this collection.</p>
        <a href="/collections/all" class="btn btn-primary">Shop All</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Collection Main",
  "settings": []
}
{% endschema %}
