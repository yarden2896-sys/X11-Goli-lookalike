<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>
    {%- if page_title == blank -%}{{ shop.name }}{%- else -%}{{ page_title }} – {{ shop.name }}{%- endif -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}" />
  {%- endif -%}

  <link rel="canonical" href="{{ canonical_url }}" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Syne:wght@700;800&display=swap" rel="stylesheet" />

  {{ 'style.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>

  <!-- ── Announcement bar ── -->
  <div class="announcement-bar" id="announcement-bar">
    <div class="announcement-inner">
      <span>🔥 Buy 2 Get 1 Free — Code <strong>GAINX11</strong></span>
      <span class="ann-sep">|</span>
      <span>Free Shipping $50+</span>
      <span class="ann-sep">|</span>
      <span>30-Day Money-Back Guarantee</span>
    </div>
    <button class="ann-close" id="ann-close" aria-label="Close">×</button>
  </div>

  <!-- ── Site header ── -->
  <header class="site-header" id="site-header">
    <div class="container nav-inner">
      <a href="{{ routes.root_url }}" class="logo-link" aria-label="X11 Home">
        <img src="{{ 'logo-red.png' | asset_url }}" alt="X11 Next-Level Nutrition" class="nav-logo" />
      </a>

      <nav class="nav-links" aria-label="Main navigation">
        <a href="{{ routes.root_url }}">Home</a>
        <a href="/collections/all">Shop All</a>
        <a href="#benefits">Benefits</a>
        <a href="#science">Science</a>
        <a href="#faq">FAQ</a>
      </nav>

      <div class="nav-actions">
        <a href="/products/x11-vegan-creatine-monohydrate-gummies-5000mg-strength-recovery" class="btn btn-nav desktop-only">Buy Now</a>
        <a href="{{ routes.cart_url }}" class="cart-icon-btn" id="cart-icon-btn" aria-label="Cart ({{ cart.item_count }} items)">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
          {%- if cart.item_count > 0 -%}
            <span class="cart-count" id="cart-count">{{ cart.item_count }}</span>
          {%- else -%}
            <span class="cart-count cart-count-hidden" id="cart-count">0</span>
          {%- endif -%}
        </a>
      </div>

      <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>

    <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
      <a href="{{ routes.root_url }}" class="mobile-link">Home</a>
      <a href="/collections/all" class="mobile-link">Shop All</a>
      <a href="#benefits" class="mobile-link">Benefits</a>
      <a href="#science" class="mobile-link">Science</a>
      <a href="#faq" class="mobile-link">FAQ</a>
      <a href="/products/x11-vegan-creatine-monohydrate-gummies-5000mg-strength-recovery" class="btn btn-primary mobile-cta">Buy Creatine Gummies</a>
    </div>
  </header>

  <!-- ── Page content ── -->
  {{ content_for_layout }}

  <!-- ── Site footer ── -->
  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <img src="{{ 'logo-tagline-light.png' | asset_url }}" alt="X11 — Next-Level Nutrition" class="footer-logo" loading="lazy" />
        <p>Fuel Your Potential. Every Rep. Every Day.</p>
        <div class="footer-socials">
          <a href="https://x11supplements.com" target="_blank" rel="noopener noreferrer" class="social-link">x11supplements.com</a>
        </div>
      </div>
      <div class="footer-links">
        <div class="footer-col">
          <strong>Shop</strong>
          <a href="/collections/all">All Products</a>
          <a href="/products/x11-vegan-creatine-monohydrate-gummies-5000mg-strength-recovery">Creatine Gummies</a>
        </div>
        <div class="footer-col">
          <strong>Support</strong>
          <a href="https://x11supplements.com/pages/contact" target="_blank" rel="noopener">Contact Us</a>
          <a href="https://x11supplements.com/policies/shipping-policy" target="_blank" rel="noopener">Shipping Policy</a>
          <a href="https://x11supplements.com/policies/refund-policy" target="_blank" rel="noopener">Refund Policy</a>
        </div>
        <div class="footer-col">
          <strong>Company</strong>
          <a href="https://x11supplements.com/pages/about" target="_blank" rel="noopener">About X11</a>
          <a href="#science">The Science</a>
          <a href="{{ routes.root_url }}#reviews">Reviews</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="container">
        <p>© {{ 'now' | date: '%Y' }} X11 Supplements. All rights reserved. · These statements have not been evaluated by the FDA. This product is not intended to diagnose, treat, cure, or prevent any disease.</p>
      </div>
    </div>
  </footer>

  <!-- ── Cart drawer ── -->
  <div class="cart-drawer-overlay" id="cart-drawer-overlay"></div>
  <div class="cart-drawer" id="cart-drawer" aria-label="Shopping cart" role="dialog" aria-modal="true">
    <div class="cart-drawer-header">
      <h3>Your Cart ({{ cart.item_count }})</h3>
      <button class="cart-drawer-close" id="cart-drawer-close" aria-label="Close cart">×</button>
    </div>
    <div class="cart-drawer-body" id="cart-drawer-body">
      {%- if cart.item_count == 0 -%}
        <div class="cart-empty">
          <p>Your cart is empty.</p>
          <a href="/collections/all" class="btn btn-primary">Shop Now</a>
        </div>
      {%- else -%}
        {%- for item in cart.items -%}
          <div class="cart-item">
            {%- if item.image -%}
              <img src="{{ item.image | img_url: '100x100', crop: 'center' }}" alt="{{ item.title | escape }}" class="cart-item-img" />
            {%- endif -%}
            <div class="cart-item-info">
              <div class="cart-item-title">{{ item.product.title }}</div>
              {%- unless item.variant.title == 'Default Title' -%}
                <div class="cart-item-variant">{{ item.variant.title }}</div>
              {%- endunless -%}
              <div class="cart-item-price">{{ item.final_price | money }}</div>
            </div>
            <div class="cart-item-qty">
              <button class="qty-btn" data-action="decrease" data-key="{{ item.key }}">−</button>
              <span>{{ item.quantity }}</span>
              <button class="qty-btn" data-action="increase" data-key="{{ item.key }}" data-qty="{{ item.quantity }}">+</button>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- if cart.item_count > 0 -%}
    <div class="cart-drawer-footer">
      <div class="cart-subtotal">
        <span>Subtotal</span>
        <strong>{{ cart.total_price | money }}</strong>
      </div>
      {%- assign free_shipping_threshold = 5000 -%}
      {%- assign remaining = free_shipping_threshold | minus: cart.total_price -%}
      {%- if remaining > 0 -%}
        <div class="free-shipping-bar">
          <span>Add {{ remaining | money }} more for <strong>free shipping</strong></span>
          <div class="fsb-track">
            <div class="fsb-fill" style="width:{{ cart.total_price | times: 100 | divided_by: free_shipping_threshold }}%"></div>
          </div>
        </div>
      {%- else -%}
        <div class="free-shipping-bar free-shipping-unlocked">✓ You've unlocked free shipping!</div>
      {%- endif -%}
      <a href="{{ routes.checkout_url }}" class="btn btn-primary btn-checkout">Checkout · {{ cart.total_price | money }}</a>
      <a href="{{ routes.cart_url }}" class="cart-view-link">View Cart</a>
    </div>
    {%- endif -%}
  </div>

  <script src="{{ 'script.js' | asset_url }}" defer></script>
</body>
</html>
